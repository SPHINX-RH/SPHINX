# StockLiquidityRouter Agent — Environment
# Copy to .env and fill in your values.

# Agent wallet private key (can ONLY publishRecommendation — NOT executeSwap)
AGENT_PRIVATE_KEY=

# Robinhood Chain RPC URL (testnet or mainnet)
RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployed StockLiquidityRouter address (set after deploy)
ROUTER_ADDRESS=

# Polling interval in seconds (default: 60)
POLL_INTERVAL_SEC=60
